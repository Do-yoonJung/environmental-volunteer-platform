# Example environment file. Copy to .env and replace EVERY value.
# All values below are placeholders only - none of them are real credentials.

SMTP_ADDRESS="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username@example.com"
SMTP_PASSWORD="REPLACE_WITH_YOUR_SMTP_PASSWORD"

MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/REPLACE_DATABASE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=5001
